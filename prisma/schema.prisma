// Smart Excel Data Entry System - Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One normalized row from an imported Excel sheet.
model MasterData {
  id             String   @id @default(cuid())
  date           String?
  shippingStatus String?
  model          String?
  sku            String?
  poNo           String?
  factoryPO      String?
  item           String?
  season         String?
  colorCode      String?
  colorCode2     String?
  painting       String?
  printingColor  String?
  size           String?
  qty1           Int?
  qty2           Int?
  deadline       String?
  productType    String?  // "MAFATE" | "ONYX" | "MIZUNO"
  sourceFile     String?
  sheetName      String?
  rowIndex       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productType])
  @@index([productType, factoryPO])
  @@index([productType, poNo])
  @@index([productType, model])
  @@index([productType, sku])
  @@index([productType, size])
  @@index([productType, shippingStatus])
  @@index([productType, deadline])
  @@index([productType, poNo, factoryPO, size])
  @@index([productType, season])
  @@index([productType, colorCode])
}

/// Aggregated shared attributes per (productType + Factory PO).
model MasterGroup {
  id              String   @id @default(cuid())
  productType     String
  factoryPO       String
  date            String?
  shippingStatus  String?
  model           String?
  sku             String?
  poNo            String?
  item            String?
  season          String?
  colorCode       String?
  colorCode2      String?
  painting        String?
  printingColor   String?
  deadline        String?
  nearestDeadline String?
  sizes           String
  sharedFlags     String
  rowCount        Int      @default(0)
  sourceFile      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productType, factoryPO])
  @@index([productType])
  @@index([productType, nearestDeadline])
}

model EntryData {
  id                  String   @id @default(cuid())
  productType         String
  date                String?
  shippingStatus      String?
  model               String?
  sku                 String?
  poNo                String?
  factoryPO           String
  item                String?
  season              String?
  colorCode           String?
  colorCode2          String?
  painting            String?
  printingColor       String?
  size                String
  qty1                Int
  qty2                Int
  deadline            String?
  // Transaction grouping: an Output entry creates a paired Pending entry,
  // both share the same transactionGroupId for atomic delete/audit.
  transactionGroupId  String?
  // Reference to the Master Data source (JSON: { factoryPO, poNo, size }).
  // Lookup ≠ Insert: entries reference master data but never mutate it.
  masterDataReference String?
  note                String?
  sourceMasterId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productType])
  @@index([productType, factoryPO])
  @@index([productType, factoryPO, size])
  @@index([productType, createdAt])
  @@index([productType, poNo])
  @@index([productType, shippingStatus])
  @@index([transactionGroupId])
}

model OrderNote {
  id          String   @id @default(cuid())
  productType String
  factoryPO   String
  size        String
  poNo        String?
  noteDate    String
  content     String
  author      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productType, factoryPO, size])
  @@index([productType, noteDate])
}

model ImportHistory {
  id           String   @id @default(cuid())
  fileName     String
  sheetName    String?
  productType  String?
  totalRows    Int      @default(0)
  validRows    Int      @default(0)
  invalidRows  Int      @default(0)
  errors       String   @default("[]")
  importedAt   DateTime @default(now())

  @@index([productType])
}

model AuditLog {
  id        String   @id @default(cuid())
  productType String?
  user      String?
  action    String  // "IMPORT" | "EDIT" | "DELETE" | "EXPORT" | "ENTRY_CREATE" | "ENTRY_EDIT" | "ENTRY_DELETE"
  entityType String  // "MasterData" | "EntryData" | "Import"
  entityId   String?
  oldValue   String?
  newValue   String?
  detail     String?
  createdAt DateTime @default(now())

  @@index([productType])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model LookupRule {
  id            String  @id @default(cuid())
  name          String  @unique
  primaryKey    String
  secondaryKey  String?
  lookupFields  String
  autoCalcQty2  Boolean @default(true)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
}

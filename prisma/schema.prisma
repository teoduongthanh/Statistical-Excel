// Smart Excel Data Entry System - Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// One normalized row from an imported Excel sheet.
model MasterData {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  date           String?
  shippingStatus String?
  model          String?
  sku            String?
  poNo           String?
  factoryPO      String?
  item           String?
  season         String?
  colorCode      String?
  colorCode2     String?
  painting       String?
  printingColor  String?
  size           String?
  qty1           Int?
  qty2           Int?
  deadline       String?
  productType    String?  // "MAFATE" | "ONYX" | "MIZUNO"
  sourceFile     String?
  sheetName      String?
  rowIndex       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productType])
  @@index([productType, factoryPO])
  @@index([productType, poNo])
  @@index([productType, model])
  @@index([productType, sku])
  @@index([productType, size])
  @@index([productType, shippingStatus])
  @@index([productType, deadline])
  @@index([productType, poNo, factoryPO, size])
  @@index([productType, season])
  @@index([productType, colorCode])
}

/// Aggregated shared attributes per (productType + Factory PO).
model MasterGroup {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productType     String
  factoryPO       String
  date            String?
  shippingStatus  String?
  model           String?
  sku             String?
  poNo            String?
  item            String?
  season          String?
  colorCode       String?
  colorCode2      String?
  painting        String?
  printingColor   String?
  deadline        String?
  nearestDeadline String?
  sizes           String
  sharedFlags     String
  rowCount        Int      @default(0)
  sourceFile      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productType, factoryPO])
  @@index([productType])
  @@index([productType, nearestDeadline])
}

model EntryData {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  productType         String
  date                String?
  shippingStatus      String?
  model               String?
  sku                 String?
  poNo                String?
  factoryPO           String
  item                String?
  season              String?
  colorCode           String?
  colorCode2          String?
  painting            String?
  printingColor       String?
  size                String
  qty1                Int
  qty2                Int
  deadline            String?
  // Transaction grouping: an Output entry creates a paired Pending entry,
  // both share the same transactionGroupId for atomic delete/audit.
  transactionGroupId  String?
  // Reference to the Master Data source (JSON: { factoryPO, poNo, size }).
  // Lookup ≠ Insert: entries reference master data but never mutate it.
  masterDataReference String?
  note                String?
  sourceMasterId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productType])
  @@index([productType, factoryPO])
  @@index([productType, factoryPO, size])
  @@index([productType, createdAt])
  @@index([productType, poNo])
  @@index([productType, shippingStatus])
  @@index([transactionGroupId])
}

model OrderNote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productType String
  factoryPO   String
  size        String
  poNo        String?
  noteDate    String
  content     String
  author      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productType, factoryPO, size])
  @@index([productType, noteDate])
}

model ImportHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName     String
  sheetName    String?
  productType  String?
  totalRows    Int      @default(0)
  validRows    Int      @default(0)
  invalidRows  Int      @default(0)
  errors       String   @default("[]")
  importedAt   DateTime @default(now())

  @@index([productType])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productType String?
  user      String?
  action    String  // "IMPORT" | "EDIT" | "DELETE" | "EXPORT" | "ENTRY_CREATE" | "ENTRY_EDIT" | "ENTRY_DELETE"
  entityType String  // "MasterData" | "EntryData" | "Import"
  entityId   String?
  oldValue   String?
  newValue   String?
  detail     String?
  createdAt DateTime @default(now())

  @@index([productType])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

model LookupRule {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String  @unique
  primaryKey    String
  secondaryKey  String?
  lookupFields  String
  autoCalcQty2  Boolean @default(true)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
}

/// Sync Queue — records each data change event that requires synchronization.
model SyncQueue {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  action        String
  entity        String
  entityId      String?
  productType   String
  poNo          String?
  factoryPO     String?
  size          String?
  changedFields String?
  status        String   @default("pending")
  error         String?
  processedAt   DateTime?
  syncDurationMs Int?
  triggeredBy   String?
  createdAt     DateTime @default(now())

  @@index([productType])
  @@index([productType, status])
  @@index([status])
  @@index([createdAt])
}

/// Sync Run — a completed synchronization batch.
model SyncRun {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  runNumber     String   @unique
  productType   String?
  eventsProcessed Int    @default(0)
  productGroupsRecalculated Int @default(0)
  errorsFound   Int      @default(0)
  warningsFound Int      @default(0)
  validationResults String?
  triggeredBy   String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  durationMs    Int?
  status        String   @default("running")

  @@index([productType])
  @@index([status])
  @@index([startedAt])
}

/// Output Slip — a preparation document for shipping out work to a factory.
/// Created from BULK OUTPUT SLIP GENERATOR. Status lifecycle:
///   DRAFT → GENERATED → PRINTED → CONFIRMED_OUTPUT | CANCELLED
/// IMPORTANT: Generating a slip does NOT add 2.Output entries to EntryData.
/// Only when the user clicks "Confirm Actual Output" (status → CONFIRMED_OUTPUT)
/// does the system create the real 2.Output (and 3.Pending if auto-calc) entries.
model OutputSlip {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slipNumber    String   @unique  // e.g. "OS-20260830-1234"
  productType   String
  poNo          String
  // Slip mode: "combined" (one slip, many Factory POs) | "separate" (one slip per FPO)
  slipMode      String   @default("combined")
  // "draft" | "generated" | "printed" | "confirmed_output" | "cancelled"
  status        String   @default("draft")
  // JSON array of { factoryPO, model, sku, season, colorCode, colorCode2,
  // painting, printingColor, size, qtyToOutput, orderQty, outputQty, deadline }
  items         String   @default("[]")
  // Summary totals (denormalized for quick list display)
  totalOrder    Int      @default(0)
  totalOutput   Int      @default(0)
  totalRemaining Int     @default(0)
  totalToOutput Int      @default(0)
  factoryPOCount Int     @default(0)
  sizeCount     Int      @default(0)
  // Audit
  createdBy     String?
  confirmedBy   String?
  confirmedAt   DateTime?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productType])
  @@index([productType, poNo])
  @@index([productType, status])
  @@index([status])
  @@index([createdAt])
}

/// ShipmentBatch — a single planned shipment row in the Daily Shipment Plan.
/// Created from the Shipment Planning view when the user picks a plannedQty
/// for a (productType + date + colorCode + poNo + factoryPO + size) group.
model ShipmentBatch {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  batchNumber     String   @unique  // e.g. "SHIP-20260101-001"
  productType     String
  date            String
  colorCode       String
  poNo            String
  factoryPO       String
  model           String?
  sku             String?
  season          String?
  size            String
  orderQty        Int      @default(0)
  previousOutput  Int     @default(0)
  plannedQty      Int      @default(0)
  remainingQty    Int      @default(0)
  deadline        String?
  // "DRAFT" | "CONFIRMED" | "EXPORTED"
  status          String   @default("DRAFT")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productType])
  @@index([productType, status])
  @@index([productType, date])
  @@index([createdAt])
}

/// Reconciliation Run — mỗi lần user upload file đối tác + chạy compare.
model ReconciliationRun {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runNumber       String   @unique // e.g. "RECON-000001"
  fileName        String
  uploadedBy      String?
  uploadedAt      DateTime @default(now())
  dateFrom        String?  // transaction date range
  dateTo          String?
  asOfDate        String?  // snapshot mode
  productType     String?
  status          String   @default("running") // running | completed | failed
  // Mapping config (JSON): { ordersSheet, summarySheet, transactionsSheet,
  //   partnerOutType, partnerInType, partnerPoField, partnerPurchasePoField }
  mappingConfig   String   @default("{}")
  // Counts (filled after run completes)
  totalLines      Int      @default(0)
  matchedLines    Int      @default(0)
  mismatchLines   Int      @default(0)
  missingOnWebsite Int     @default(0)
  missingOnPartner Int     @default(0)
  duplicateLines  Int      @default(0)
  overOutputLines Int      @default(0)
  overInputLines  Int      @default(0)
  dateDiffLines   Int      @default(0)
  invalidLines    Int      @default(0)
  // Aggregate totals
  totalOrderQty   Int      @default(0)
  totalPartnerOut Int      @default(0)
  totalWebsiteOutput Int   @default(0)
  totalPartnerIn  Int      @default(0)
  totalWebsiteInput Int    @default(0)
  // Preview stats (before run)
  previewOrdersCount Int   @default(0)
  previewSummaryCount Int  @default(0)
  previewTxCount   Int     @default(0)
  error           String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([fileName])
  @@index([status])
  @@index([createdAt])
  @@index([productType])
}

/// Reconciliation Result — 1 row = 1 business line (PO + FactoryPO + Size).
model ReconciliationResult {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runId           String
  // Business key
  poNo            String
  factoryPO       String
  size            String
  // Optional context
  model           String?
  sku             String?
  colorCode       String?
  // Partner quantities
  partnerOrderQty Int      @default(0)
  partnerOutQty   Int      @default(0)
  partnerInQty    Int      @default(0)
  // Website quantities
  websiteOrderQty Int      @default(0)
  websiteOutputQty Int     @default(0)
  websiteInputQty Int      @default(0)
  // Differences (Partner - Website)
  orderDifference Int      @default(0)
  outDifference   Int      @default(0)
  inDifference    Int      @default(0)
  // Balances
  pendingPartner  Int      @default(0) // OUT - IN at partner
  pendingWebsite  Int      @default(0) // Output - Input on website
  remainingOrder  Int      @default(0) // Order - Output
  // Status + issues
  status          String   @default("MATCHED") // MATCHED | QTY_MISMATCH | OUTPUT_MISMATCH | INPUT_MISMATCH | ORDER_QTY_MISMATCH | MISSING_ON_WEBSITE | MISSING_ON_PARTNER | OVER_OUTPUT | OVER_INPUT | STILL_WITH_PARTNER | POSSIBLE_DUPLICATE | DATE_DISTRIBUTION_MISMATCH | POSSIBLE_WRONG_FACTORY_PO | POSSIBLE_WRONG_SIZE | INVALID_DATA | AMBIGUOUS
  issues          String   @default("[]") // JSON array of issue codes
  reason          String?  // human-readable explanation
  // Transaction details (JSON arrays for drill-down)
  partnerTransactions String @default("[]")
  websiteTransactions String @default("[]")
  // Date distribution check
  dateDiff       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([runId])
  @@index([runId, status])
  @@index([runId, poNo])
  @@index([runId, poNo, factoryPO])
  @@index([runId, poNo, factoryPO, size])
}

/// Entry Batch — a staging batch of pasted rows awaiting validation + confirm.
/// Spec §4: data goes to Staging first, NOT directly to DB.
model EntryBatch {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String   @unique // e.g. "ENTRY-20261004-0001"
  productType     String
  createdBy       String?
  createdAt       DateTime @default(now())
  status          String   @default("staging") // staging | validated | importing | imported | cancelled
  totalRows       Int      @default(0)
  validRows       Int      @default(0)
  warningRows     Int      @default(0)
  errorRows       Int      @default(0)
  reviewedRows    Int      @default(0)
  importedRows    Int      @default(0)
  // Raw paste text (for audit)
  rawText         String?
  // Last validation run summary (JSON)
  lastValidation  String   @default("{}")
  importedAt      DateTime?
  createdAt2      DateTime @default(now()) @map("created_at_2")
  updatedAt       DateTime @updatedAt

  @@index([productType])
  @@index([status])
  @@index([createdAt])
}

/// Entry Staging Row — one row in a batch, with raw + normalized + validation.
/// Spec §48: must keep both raw input and normalized data.
model EntryStagingRow {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String
  rowNumber       Int
  // Business fields (normalized)
  shippingStatus  String?
  date            String?
  poNo            String?
  factoryPO       String?
  size            String?
  qty             Int      @default(0)
  deadline        String?
  // Auto-filled from matching Order (spec §34: show source)
  model           String?
  sku             String?
  item            String?
  season          String?
  colorCode       String?
  colorCode2      String?
  painting        String?
  printingColor   String?
  autoFillSource  String? // e.g. "ORDER:MH25100234" or "MASTER_GROUP"
  matchedOrderKey String? // poNo|factoryPO|size of matched 1.Order
  // Raw input (spec §48)
  rawData         String   @default("{}")
  // Validation
  validationStatus String  @default("PENDING") // PENDING | VALID | WARNING | ERROR | REVIEWED
  validationErrors String  @default("[]") // JSON array of issues
  // Warning acceptance (spec §31)
  warningAccepted Boolean  @default(false)
  warningAcceptedBy String?
  warningAcceptedAt DateTime?
  warningAcceptReason String?
  // Import tracking
  imported        Boolean  @default(false)
  importedEntryId String? // ref to EntryData after import
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([batchId])
  @@index([batchId, validationStatus])
  @@index([batchId, poNo, factoryPO, size])
}

/// Entry Validation Run — each validation pass is recorded (spec §67).
model EntryValidationRun {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String
  runNumber       Int
  runAt           DateTime @default(now())
  totalRows       Int      @default(0)
  validRows       Int      @default(0)
  warningRows     Int      @default(0)
  errorRows       Int      @default(0)
  reviewedRows    Int      @default(0)
  // Full results snapshot (JSON array of {rowId, status, issues})
  results         String   @default("[]")
  duration        Int?

  @@index([batchId])
  @@index([runNumber])
}

/// Entry Audit Log — all actions on staging rows (spec §46).
model EntryAuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String
  rowId           String?
  action          String // CREATE | EDIT | ACCEPT_WARNING | ADD_MASTER | REVALIDATE | IMPORT
  field           String?
  oldValue        String?
  newValue        String?
  user            String?
  detail          String?
  createdAt       DateTime @default(now())

  @@index([batchId])
  @@index([rowId])
  @@index([action])
  @@index([createdAt])
}

/// Product — dynamic product registration (spec: add new products freely).
/// Replaces hardcoded ProductType union. Each product has its own data isolation.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productType String   @unique // "MAFATE", "ONYX", "MIZUNO", or any new product
  label       String   // Display name e.g. "Mafate", "Onyx Pro"
  slug        String   @unique // URL slug e.g. "mafate", "onyx-pro"
  description String?
  // Theme colors (auto-generated if not specified)
  color       String   @default("emerald") // Tailwind color name: emerald, violet, rose, blue, amber, etc.
  // Active flag (soft delete)
  active      Boolean  @default(true)
  // Sort order in sidebar
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

// ── Comparison Studio models (spec: Data Relationship & Comparison Studio) ──

/// Comparison Profile — saved configuration for comparing 2 datasets.
/// Spec §4: user creates profiles, each defines source/target datasets,
/// field mappings, transformations, match keys, aggregation, metrics, rules.
model ComparisonProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  description     String?
  sourceDataset   String   // productType of source (e.g., "ONYX")
  targetDataset   String   // productType of target (e.g., "ONYX_FVO")
  // Status mapping (spec §47): source status → target status
  // JSON: { "2.Output": "4.Input", "1.Order": "1.Order" }
  statusMapping   String   @default("{}")
  // Match key fields (spec §14): JSON array of field names
  // e.g., ["poNo", "factoryPO", "size"]
  matchKeyFields  String   @default("[]")
  // Field mappings (spec §6): JSON array of {sourceField, targetField, type, transformRule}
  // type: EXACT | NORMALIZED | TRANSFORMED | COMPARE
  fieldMappings   String   @default("[]")
  // Aggregation config (spec §45): JSON { qtyField: "qty1", method: "SUM" }
  aggregationConfig String @default("{}")
  // Comparison metrics (spec §21): JSON array of metric configs
  // e.g., [{ type: "DIFFERENCE", direction: "SOURCE_MINUS_TARGET" }, { type: "PERCENTAGE" }]
  metrics         String   @default("[]")
  // Rules (spec §26): JSON array of { condition, status, priority }
  rules           String   @default("[]")
  // Mode (spec §64): STRICT | BALANCED | SMART
  mode            String   @default("SMART")
  // Versioning (spec §55)
  version         Int      @default(1)
  // Active flag
  active          Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceDataset, targetDataset])
  @@index([active])
}

/// Comparison Run — each execution of a profile (spec §57).
model ComparisonRun {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runId           String   @unique // e.g., "CMP-000001"
  profileId       String
  profileName     String
  profileVersion  Int      @default(1)
  sourceDataset   String
  targetDataset   String
  // Filters applied (JSON)
  filters         String   @default("{}")
  // Summary stats
  totalCompared   Int      @default(0)
  matchedCount     Int      @default(0)
  mismatchCount   Int      @default(0)
  missingSource   Int      @default(0)
  missingTarget   Int      @default(0)
  ambiguousCount   Int      @default(0)
  shortageCount   Int      @default(0)
  overageCount    Int      @default(0)
  // Totals
  sourceTotalQty  Int      @default(0)
  targetTotalQty  Int      @default(0)
  totalDifference Int      @default(0)
  matchPercentage Float    @default(0)
  // Status
  status          String   @default("running") // running | completed | failed
  error           String?
  duration        Int?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
}

/// Comparison Result — one row per matched/unmatched group (spec §32, §68).
model ComparisonResult {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runId           String   // ref to ComparisonRun.runId
  // Business key (composite — spec §13)
  key             String
  // Source data (JSON: { poNo, factoryPO, size, qty, date, ... })
  sourceData      String   @default("{}")
  // Target data (JSON)
  targetData      String   @default("{}")
  // Match info
  sourceQty       Int      @default(0)
  targetQty       Int      @default(0)
  difference      Int      @default(0)
  percentage      Float    @default(0)
  // Status (spec §25)
  status          String   // MATCHED | QTY_MISMATCH | MISSING_SOURCE | MISSING_TARGET | AMBIGUOUS | OVERAGE | SHORTAGE
  issues          String   @default("[]") // JSON array of issue strings
  // Match metadata
  matchType       String?  // EXACT | NORMALIZED | TRANSFORMED | MANUAL
  // Source/target row refs (JSON arrays of row numbers for drill-down)
  sourceRowRefs   String   @default("[]")
  targetRowRefs   String   @default("[]")
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([runId, status])
  @@index([runId, key])
}

/// Manual Relationship — user-created links (spec §61).
model ManualRelationship {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String
  sourceDataset   String
  targetDataset   String
  sourceKey       String   // composite key
  targetKey       String
  linkedBy        String?
  linkedAt        DateTime @default(now())
  reason          String?

  @@index([profileId])
  @@index([sourceDataset, targetDataset])
}

// ── Reconciliation Tool models (spec F1–F9) ─────────────────────────────────
// A standalone tool similar to Comparison Studio but with F3 size transform
// rules, F4 comparison config, F5 status engine, F6 dashboard data, F8 multi-
// sheet Excel export. Stored separately so that RECON_TOOL profiles/runs don't
// pollute the comparison-studio history.

/// Reconciliation Tool Profile — saved configuration (F2 + F3 + F4).
model ReconToolProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  description     String?
  sourceDataset   String   // productType of source (e.g. "ONYX_FVO")
  targetDataset   String   // productType of target (e.g. "ONYX")
  // F2: column mappings JSON array of { sourceField, targetField, role }
  //   role: PRIMARY_KEY | SECONDARY_KEY | ATTRIBUTE | QUANTITY | DATE | FILTER
  fieldMappings   String   @default("[]")
  // F4: match keys (subset of source fields used to build the composite key)
  matchKeys       String   @default("[]")
  // F4: status mapping source→target (JSON Record)
  statusMapping   String   @default("{}")
  // F4: tolerance config JSON: { type: "absolute"|"percentage", value: number }
  tolerance       String   @default("{\"type\":\"absolute\",\"value\":0}")
  // F4: mode "row_to_row" | "aggregate"
  mode            String   @default("aggregate")
  // F4: pre-filter JSON: { shippingStatus?, dateFrom?, dateTo? }
  preFilter       String   @default("{}")
  // F3: size transformation rules JSON array of SizeTransformRule
  sizeTransformRules String @default("[]")
  // F3: extra normalize flags JSON { trim, upper, removeWhitespace, commaToDot }
  normalizeConfig String   @default("{}")
  active          Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceDataset, targetDataset])
  @@index([active])
}

/// Reconciliation Tool Run — each execution of a profile.
model ReconToolRun {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runId           String   @unique // e.g. "RT-20260101-001"
  profileId       String
  profileName     String
  sourceDataset   String
  targetDataset   String
  // Snapshot of config used (JSON) — so changing the profile later doesn't
  // invalidate past runs.
  configSnapshot  String   @default("{}")
  // Summary counts by status (F5 + F6 KPIs)
  totalLines      Int      @default(0)
  matchedOk       Int      @default(0)
  partial         Int      @default(0)
  over            Int      @default(0)
  missingOut      Int      @default(0)
  orphan          Int      @default(0)
  dup             Int      @default(0)
  attrMismatch    Int      @default(0)
  fmtFixed        Int      @default(0)
  suspectPo       Int      @default(0)
  // Quantity totals
  sourceTotalQty  Int      @default(0)
  targetTotalQty  Int      @default(0)
  totalDifference Int      @default(0)
  matchPercentage Float    @default(0)
  // F6: chart data JSON (donut, stacked bar, top shortage, heatmap, timeline)
  chartData       String   @default("{}")
  status          String   @default("running") // running | completed | failed
  error           String?
  duration        Int?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
}

/// Reconciliation Tool Result — one row per matched/unmatched key.
model ReconToolResult {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  runId           String
  // Business key (composite — F2/F4 matchKeys joined by "|")
  key             String
  // Source / target snapshot (JSON)
  sourceData      String   @default("{}")
  targetData      String   @default("{}")
  // Quantities
  sourceQty       Int      @default(0)
  targetQty       Int      @default(0)
  difference      Int      @default(0)
  percentage      Float    @default(0)
  // F5 status — one of the 9 canonical statuses
  status          String   // MATCHED_OK | PARTIAL | OVER | MISSING_OUT | ORPHAN | DUP | ATTR_MISMATCH | FMT_FIXED | SUSPECT_PO
  issues          String   @default("[]") // JSON array of issue strings
  matchType       String?  // EXACT | NORMALIZED | TRANSFORMED | MANUAL
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([runId, status])
  @@index([runId, key])
}

// ── Reconciliation V2: Project Management (spec F10-F12) ────────────────────

/// Recon Project — a saved workspace with sources, mappings, rules, runs (F10).
model ReconProject {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique
  description   String?
  tags          String   @default("[]") // JSON array of tag strings
  // Source datasets (JSON: { source: { dataset, productType }, target: { dataset, productType } })
  sourceConfig  String   @default("{}")
  targetConfig  String   @default("{}")
  // Field mappings (JSON array: { sourceField, targetField, role, transformRule })
  fieldMappings String   @default("[]")
  // Match key fields (JSON array)
  matchKeyFields String   @default("[]")
  // Transformation rules (JSON array: { order, type, config, enabled })
  rules         String   @default("[]")
  // Comparison config (JSON: { tolerance, mode, preFilter, nullHandling })
  comparisonConfig String @default("{}")
  // Status mapping (JSON: source status → target status)
  statusMapping String   @default("{}")
  // Size transform tables (JSON: { men: {...}, women: {...} })
  sizeTables    String   @default("{}")
  // Project status
  status        String   @default("active") // active | archived | template
  template      Boolean  @default(false)
  // Mini-KPI cache (updated after each run)
  lastRunId     String?
  lastRunAt     DateTime?
  lastMatchPercent Float  @default(0)
  lastTotalLines Int     @default(0)
  lastMatched    Int      @default(0)
  lastMismatch   Int      @default(0)
  lastMissing    Int      @default(0)
  lastOrphan     Int      @default(0)
  // Sync status
  lastSyncAt    DateTime?
  syncStatus    String   @default("never") // never | ok | error | syncing
  nextSyncAt    DateTime?
  // Audit
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([template])
  @@index([createdAt])
}

/// DataSource — connection config for each data source (F12).
model ReconDataSource {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String
  name          String   // "Source A (Onyx-FVO)" or "Source B (Onyx-Stech)"
  dataset       String   // productType: "ONYX_FVO" or "ONYX"
  type          String   @default("database") // database | api | file
  // Connection config (JSON: { url, headers, schedule, etc. })
  config        String   @default("{}")
  // Sync schedule
  syncSchedule  String   @default("manual") // manual | 15m | 1h | 1d
  lastSyncedAt  DateTime?
  lastSyncStatus String  @default("never") // never | ok | error | syncing
  lastSyncError String?
  syncHealth    String   @default("unknown") // unknown | healthy | degraded | offline
  // Snapshot count
  snapshotCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([dataset])
}

/// Snapshot — versioned data snapshot (F12).
model ReconSnapshot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  dataSourceId  String
  projectId     String
  fetchedAt     DateTime @default(now())
  rowCount      Int      @default(0)
  // Storage: for DB-type sources, we query live; for file/api, store hash reference
  storageRef    String?  // file path or hash reference
  contentHash   String?  // MD5/SHA of data content for change detection
  // Change detection vs previous snapshot
  changesAdded  Int      @default(0)
  changesModified Int    @default(0)
  changesDeleted Int     @default(0)
  // Status
  status        String   @default("completed") // fetching | completed | failed
  error         String?

  @@index([dataSourceId])
  @@index([projectId])
  @@index([fetchedAt])
}

/// Project Run — each reconciliation execution (F10/F12).
model ProjectRun {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  runId         String   @unique // e.g., "PR-20261009-001"
  projectId     String
  // Snapshot IDs used for this run
  sourceSnapshotId String?
  targetSnapshotId String?
  // Trigger info
  trigger       String   @default("manual") // manual | auto | scheduled
  triggeredBy   String?
  // Summary stats
  totalLines    Int      @default(0)
  matchedOk     Int      @default(0)
  partial       Int      @default(0)
  over          Int      @default(0)
  missingOut    Int      @default(0)
  orphan        Int      @default(0)
  dup           Int      @default(0)
  attrMismatch  Int      @default(0)
  fmtFixed      Int      @default(0)
  suspectPo    Int      @default(0)
  // Quantity totals
  sourceTotalQty Int     @default(0)
  targetTotalQty Int     @default(0)
  totalDifference Int    @default(0)
  matchPercent  Float    @default(0)
  // Status
  status        String   @default("running") // running | completed | failed
  error         String?
  duration       Int?    // milliseconds
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([startedAt])
}

/// Project Result Row — one comparison result line (F5/F11).
model ProjectResultRow {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  runId         String
  projectId     String
  // Composite key
  key           String
  // Source data (JSON: full row from source A)
  sourceData    String   @default("{}")
  // Target data (JSON: full row from source B)
  targetData    String   @default("{}")
  // Quantities
  sourceQty     Int      @default(0)
  targetQty     Int      @default(0)
  difference    Int      @default(0)
  // Status code (F5)
  statusCode    String   // MATCHED_OK | PARTIAL | OVER | MISSING_OUT | ORPHAN | DUP | ATTR_MISMATCH | FMT_FIXED | SUSPECT_PO
  // Diagnostic info (F11: match trace, cause suggestions, similar cases)
  diagnostic    String   @default("{}") // JSON
  // Resolution
  resolved      Boolean  @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  note          String?
  assignedTo    String?
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([runId, statusCode])
  @@index([projectId])
  @@index([projectId, resolved])
}

/// Project Audit Log — all actions (F10).
model ProjectAuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String
  action        String   // CREATE | UPDATE | DELETE | RUN | SYNC | ARCHIVE | RESTORE | DUPLICATE | EXPORT | IMPORT
  entityType    String   // project | mapping | rule | run | result | source | snapshot
  entityId      String?
  oldValue      String?
  newValue      String?
  user          String?
  detail        String?
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([action])
  @@index([createdAt])
}

/// Project Notification — in-app + email/webhook (F12).
model ProjectNotification {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String
  type          String   // sync_completed | sync_error | new_mismatch | deadline_approaching | run_completed
  severity      String   @default("info") // info | warning | error | success
  title         String
  message       String
  read          Boolean  @default(false)
  // Action data (JSON)
  actionData    String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([read])
  @@index([createdAt])
}

/// EntryRecord — manual data entry records (spec DE4-DE6).
/// Each record stores manually entered data into Nguồn A or B,
/// with business date (user-selected) + system timestamp (auto).
model EntryRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String?  // optional: link to Reconciliation V2 project
  productType   String   // "ONYX" | "ONYX_FVO" | "MAFATE" | etc.
  targetSource  String   // "A" (source/order) | "B" (target/actual)
  // Business data (JSON: { shippingStatus, poNo, factoryPO, model, art, size, qty, colorCode, ... })
  data          String   @default("{}")
  // Dates
  businessDate  String   // yyyy-MM-dd — user-selected (can be backdated)
  recordedAt    DateTime @default(now()) // system timestamp (auto, immutable)
  // Metadata
  source        String   @default("manual") // manual | import | sync
  createdBy     String?
  status        String   @default("active") // active | deleted
  note          String?
  // Duplicate detection hash
  dedupHash     String?  // hash of poNo+size+businessDate+shippingStatus
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productType, targetSource])
  @@index([projectId])
  @@index([businessDate])
  @@index([status])
  @@index([dedupHash])
}

// ── Chronology & Causality Validation (spec VAL1-VAL7) ──────────────────────

/// Validation Rule — per-project chronology/causality rules (spec VAL4).
model ValidationRule {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String?
  code          String   @unique // INPUT_BEFORE_SEND | OUTPUT_BEFORE_INPUT | RECEIVED_OVER_SENT | etc.
  description   String?
  enabled       Boolean  @default(true)
  severity      String   @default("ERROR") // ERROR | WARNING | INFO
  policy        String   @default("flag") // flag | exclude | warn_only
  config        String   @default("{}") // JSON: { tolerance_days, stage_order, ... }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([enabled])
}

/// Violation — detected chronology/causality violations (spec VAL5).
model Violation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  runId         String?  // ref to ProjectRun or standalone run
  projectId     String?
  productType   String
  ruleCode      String   // INPUT_BEFORE_SEND | RECEIVED_OVER_SENT | etc.
  severity      String   // ERROR | WARNING | INFO
  key           String   // composite key: poNo|factoryPO|size
  // Evidence (JSON: array of { stage, date, qty, rowId, sourceData })
  evidence      String   @default("[]")
  // Diagnostic (JSON: { timeline, explanation, cause_suggestions, similar_cases })
  diagnostic    String   @default("{}")
  resolved      Boolean  @default(false)
  resolvedBy    String?
  resolvedAt   DateTime?
  note          String?
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([projectId])
  @@index([ruleCode])
  @@index([severity])
  @@index([resolved])
  @@index([productType])
}

/// Validation Run — each validation execution (spec VAL7).
model ValidationRun {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  runId         String   @unique // e.g., "VAL-20261015-001"
  projectId     String?
  productType   String
  trigger       String   @default("manual") // manual | auto | sync
  totalKeys     Int      @default(0)
  totalViolations Int    @default(0)
  errorCount    Int      @default(0)
  warningCount  Int      @default(0)
  infoCount     Int      @default(0)
  // Per-rule breakdown (JSON: { ruleCode: count })
  ruleBreakdown String   @default("{}")
  status        String   @default("running") // running | completed | failed
  error         String?
  duration      Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([productType])
  @@index([status])
  @@index([createdAt])
}
